---
import ChangeCard from "./ChangeCard.astro";
import ChangePagination from "./ChangePagination.astro";
import type { ChangeEvent } from "../types";

interface Props {
  events: ChangeEvent[];
  filterEvents: ChangeEvent[];
  totalEvents: number;
  currentPage: number;
  totalPages: number;
}

const { events, filterEvents, totalEvents, currentPage, totalPages } = Astro.props;
const base = import.meta.env.BASE_URL;
const agencies = [...new Set(filterEvents.map((event) => event.agency_name).filter(Boolean))].sort();
const fields = [...new Set(filterEvents.map((event) => event.field_name))].sort();
const fieldLabels = new Map(filterEvents.map((event) => [event.field_name, event.field_label]));
---

<section
  class="content-section changes-section"
  id="changes"
  data-current-page={currentPage}
  data-base={base}
  data-events-url={`${base}data/change-events.json`}
>
  <div class="section-heading">
    <div>
      <p class="eyebrow"><span></span> Change feed</p>
      <h2>What changed?</h2>
      <p>
        Every published comparison links back to the supporting source releases. Collection
        is bounded and its latest interval counts are published on the data page.
      </p>
    </div>
    <a class="download-link" href={`${base}data/change-events.csv`} download>Download published CSV ↓</a>
  </div>

  <form class="filters" data-filters aria-label="Filter all published contract changes">
    <label class="search-field">
      <span>Search</span>
      <div>
        <span aria-hidden="true">⌕</span>
        <input type="search" name="query" placeholder="Contract, agency, supplier…" autocomplete="off" />
      </div>
    </label>
    <label>
      <span>Agency</span>
      <select name="agency">
        <option value="">All agencies</option>
        {agencies.map((agency) => <option value={agency}>{agency}</option>)}
      </select>
    </label>
    <label>
      <span>Field</span>
      <select name="field">
        <option value="">All fields</option>
        {fields.map((field) => <option value={field}>{fieldLabels.get(field)}</option>)}
      </select>
    </label>
    <label>
      <span>Direction</span>
      <select name="direction">
        <option value="">Any direction</option>
        <option value="increase">Increase</option>
        <option value="decrease">Decrease</option>
        <option value="extension">Extension</option>
        <option value="reduction">Reduction</option>
        <option value="changed">Other change</option>
      </select>
    </label>
    <button class="reset-button" type="reset">Clear</button>
  </form>

  <div class="result-line">
    <p aria-live="polite" data-result-summary>
      <strong data-result-count>{events.length}</strong><span data-result-detail>{` matching changes on page ${currentPage} of ${totalPages}. ${totalEvents} published events in total`}</span>
    </p>
    <button class="text-button" type="button" data-download-filtered>Download filtered CSV</button>
  </div>
  <p class="page-filter-note" data-filter-note>
    Filters and the filtered CSV cover all published events. Results are shown 50 per page.
  </p>

  <ChangePagination currentPage={currentPage} totalPages={totalPages} position="top" />

  <div class="change-grid" data-change-grid>
    {events.map((event) => <ChangeCard event={event} />)}
  </div>
  <div class="empty-state" data-empty hidden>
    <span aria-hidden="true">∅</span>
    <h3>No changes match those filters</h3>
    <p>Try a broader search or clear the filters.</p>
  </div>

  <ChangePagination currentPage={currentPage} totalPages={totalPages} position="bottom" />
</section>

<script>
  import { setupChangeFeed } from "../lib/change-feed-client";

  document.addEventListener("astro:page-load", setupChangeFeed);
</script>
