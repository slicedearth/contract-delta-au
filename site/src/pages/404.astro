---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found | ContractDelta AU">
  <section class="not-found">
    <span>404 / NO RECORD</span>
    <h1>This page did not survive the diff.</h1>
    <p>The requested route is not part of the current static dataset.</p>
    <a class="button button--primary" href={base}>Return to the change feed</a>
  </section>
</BaseLayout>
