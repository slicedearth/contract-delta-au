---
import BaseLayout from "../../layouts/BaseLayout.astro";
import rawDashboard from "../../data/dashboard.json";
import type { Contract, Dashboard } from "../../types";
import { formatDate, formatMoney, formatValue, truncateHash } from "../../lib/format";

export function getStaticPaths() {
  const dashboard = rawDashboard as Dashboard;
  return dashboard.contracts.map((contract) => ({
    params: { id: contract.contract_id },
    props: { contract }
  }));
}

interface Props {
  contract: Contract;
}

const { contract } = Astro.props;
const base = import.meta.env.BASE_URL;
const valueDirection = Number(contract.value_change ?? 0) >= 0 ? "increase" : "decrease";
const title = `${contract.contract_id}: ${contract.description} — ContractDelta AU`;
const description = `${contract.amendment_count} amendments and ${contract.events.length} field changes for ${contract.contract_id}.`;
---

<BaseLayout title={title} description={description}>
  <article class="contract-page">
    <header class="contract-hero">
      <a class="back-link" href={`${base}#changes`}>← Back to change feed</a>
      <div class="contract-hero__identity">
        <div>
          <p class="eyebrow eyebrow--light"><span></span> Contract timeline</p>
          <h1>{contract.contract_id}</h1>
        </div>
        <span class="amendment-badge">{contract.amendment_count} {contract.amendment_count === 1 ? "amendment" : "amendments"}</span>
      </div>
      <p class="contract-description">{contract.description}</p>
      <div class="contract-hero__parties">
        <div><span>Agency</span><strong>{contract.agency_name}</strong></div>
        <div><span>Supplier</span><strong>{contract.supplier_name}</strong></div>
      </div>
    </header>

    <section class="contract-value-panel" aria-labelledby="reported-value-heading">
      <div>
        <p class="eyebrow"><span></span> Reported contract value</p>
        <h2 id="reported-value-heading">{formatMoney(contract.current_reported_value, contract.currency)}</h2>
        <p>Current maximum value reported over the contract’s life—not annual expenditure.</p>
      </div>
      {contract.value_change !== null && (
        <div class:list={["total-delta", `total-delta--${valueDirection}`]}>
          <span>Since first version</span>
          <strong>
            {Number(contract.value_change) >= 0 ? "+" : "−"}{formatMoney(String(Math.abs(Number(contract.value_change))), contract.currency)}
          </strong>
          {contract.value_change_percentage !== null && <small>{Number(contract.value_change_percentage) >= 0 ? "+" : ""}{contract.value_change_percentage}%</small>}
        </div>
      )}
    </section>

    <div class="contract-content-grid">
      <section class="timeline-section" aria-labelledby="timeline-heading">
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow"><span></span> Evidence history</p>
            <h2 id="timeline-heading">Version timeline</h2>
          </div>
          <p>{contract.versions.length} source {contract.versions.length === 1 ? "version" : "versions"}</p>
        </div>

        <ol class="timeline">
          {contract.versions.map((version, index) => {
            const versionEvents = contract.events.filter((event) => event.notice_id === version.notice_id);
            return (
              <li class:list={[index === contract.versions.length - 1 && "timeline__current"]}>
                <div class="timeline__marker" aria-hidden="true">{index === 0 ? "●" : "Δ"}</div>
                <article>
                  <div class="timeline__topline">
                    <span>{index === 0 ? "First published version" : `Amendment ${index}`}</span>
                    {index === contract.versions.length - 1 && <b>Current</b>}
                  </div>
                  <div class="timeline__identity">
                    <h3>{version.notice_id}</h3>
                    <time datetime={version.source_modified_at}>{formatDate(version.source_modified_at, true)}</time>
                  </div>
                  <dl class="timeline__facts">
                    <div><dt>Reported value</dt><dd>{formatMoney(version.reported_value, version.currency)}</dd></div>
                    <div><dt>Contract period</dt><dd>{formatDate(version.contract_start_date)} — {formatDate(version.contract_end_date)}</dd></div>
                    <div><dt>Supplier</dt><dd>{version.supplier_name}</dd></div>
                  </dl>
                  {versionEvents.length > 0 && (
                    <div class="timeline__changes">
                      <p>Changes in this version</p>
                      {versionEvents.map((event) => (
                        <div class="timeline-change">
                          <span class:list={["direction-icon", `direction-icon--${event.direction}`]} aria-hidden="true">
                            {event.direction === "increase" || event.direction === "extension" ? "↗" : event.direction === "decrease" || event.direction === "reduction" ? "↘" : "↔"}
                          </span>
                          <div>
                            <strong>{event.summary}</strong>
                            <span>{formatValue(event.old_value, event.field_name, version.currency)} → {formatValue(event.new_value, event.field_name, version.currency)}</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                  <details class="evidence-details">
                    <summary>Evidence identifiers</summary>
                    <dl>
                      <div><dt>Release ID</dt><dd><code>{version.source_release_id}</code></dd></div>
                      <div><dt>Normalised SHA-256</dt><dd><code title={version.source_hash}>{truncateHash(version.source_hash)}</code></dd></div>
                    </dl>
                  </details>
                </article>
              </li>
            );
          })}
        </ol>
      </section>

      <aside class="contract-sidebar">
        <section>
          <h2>Contract facts</h2>
          <dl class="fact-list">
            <div><dt>Reference</dt><dd>{contract.title ?? "Not reported"}</dd></div>
            <div><dt>Category code</dt><dd>{contract.category_code ?? "Not reported"}</dd></div>
            <div><dt>Procurement method</dt><dd>{contract.procurement_method ?? "Not reported"}</dd></div>
            <div><dt>Start date</dt><dd>{formatDate(contract.contract_start_date)}</dd></div>
            <div><dt>End date</dt><dd>{formatDate(contract.contract_end_date)}</dd></div>
            <div><dt>Latest notice</dt><dd>{contract.notice_id}</dd></div>
          </dl>
        </section>
        <section class="evidence-box">
          <span aria-hidden="true">⌁</span>
          <h2>Inspect the evidence</h2>
          <p>The bundle includes normalised versions, field events, release IDs, and hashes.</p>
          <a class="button button--primary" href={`${base}${contract.evidence_path}`} download>Download evidence JSON</a>
          <a class="button button--ghost-dark" href={contract.source_url}>Open primary record ↗</a>
        </section>
        <section class="sidebar-note">
          <h2>Use with care</h2>
          <p>A source change can reflect a legitimate variation or a data correction. Review the primary record and surrounding context.</p>
          <a class="text-link" href={`${base}methodology/`}>Methodology & limitations →</a>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
