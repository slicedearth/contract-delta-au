---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChangeFeed from "../components/ChangeFeed.astro";
import rawDashboard from "../data/dashboard.json";
import type { Dashboard } from "../types";
import { formatDate, formatMoney } from "../lib/format";
import { getChangePage, getChangePageCount } from "../lib/pagination";

const dashboard = rawDashboard as Dashboard;
const base = import.meta.env.BASE_URL;
const totalChangePages = getChangePageCount(dashboard.events.length);
const firstPageEvents = getChangePage(dashboard.events, 1);
---

<BaseLayout>
  <section class="hero">
    <div class="hero__copy">
      <p class="eyebrow"><span></span> Public records, change-tracked</p>
      <h1>See the contract.<br /><em>See the change.</em></h1>
      <p class="hero__lede">
        ContractDelta makes amendments to Australian Government contracts visible,
        verifiable, and easier to investigate without making claims the data cannot support.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="#changes">Explore published changes ↓</a>
        <a class="button button--ghost" href={`${base}methodology/`}>How it works</a>
      </div>
    </div>
    <div class="hero__signal" aria-label="Current dataset summary">
      <div class="signal-grid" aria-hidden="true"></div>
      <div class="signal-stamp">LIVE DATASET</div>
      <p>Current reported value across change-tracked notices</p>
      <strong>{formatMoney(dashboard.stats.current_reported_value)}</strong>
      <div class="signal-delta">
        <span>Δ</span>
        <div>
          <b>{dashboard.stats.change_events}</b>
          <small>field changes preserved</small>
        </div>
      </div>
      <div class="signal-meta">
        <span>Latest source record</span>
        <time datetime={dashboard.latest_source_modified_at ?? undefined}>
          {formatDate(dashboard.latest_source_modified_at, true)}
        </time>
      </div>
    </div>
  </section>

  <section class="metric-strip" aria-label="Dataset metrics">
    <div><strong>{dashboard.stats.changed_contracts}</strong><span>Changed contracts</span></div>
    <div><strong>{dashboard.stats.amendments_tracked}</strong><span>Amendments tracked</span></div>
    <div><strong>{dashboard.stats.change_events}</strong><span>Field-level events</span></div>
    <div class="metric-strip__source">
      <span class="status-dot"></span>
      <span>Source: AusTender OCDS</span>
    </div>
  </section>

  <ChangeFeed
    events={firstPageEvents}
    totalEvents={dashboard.events.length}
    currentPage={1}
    totalPages={totalChangePages}
  />

  <section class="profiles-section">
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow eyebrow--light"><span></span> Profiles</p>
        <h2>Follow the pattern,<br />not just the headline.</h2>
      </div>
      <p>
        Compare amendment activity by agency and supplier. Counts describe source records,
        not performance or conduct.
      </p>
    </div>
    <div class="profile-columns">
      <section aria-labelledby="agency-heading">
        <div class="profile-title"><h3 id="agency-heading">Agencies</h3><span>Events</span></div>
        <ol>
          {dashboard.agencies.slice(0, 4).map((agency, index) => (
            <li>
              <span class="rank">{String(index + 1).padStart(2, "0")}</span>
              <div><strong>{agency.name}</strong><small>{agency.contracts} changed {agency.contracts === 1 ? "contract" : "contracts"}</small></div>
              <b>{agency.events}</b>
            </li>
          ))}
        </ol>
      </section>
      <section aria-labelledby="supplier-heading">
        <div class="profile-title"><h3 id="supplier-heading">Suppliers</h3><span>Events</span></div>
        <ol>
          {dashboard.suppliers.slice(0, 4).map((supplier, index) => (
            <li>
              <span class="rank">{String(index + 1).padStart(2, "0")}</span>
              <div><strong>{supplier.name}</strong><small>{formatMoney(supplier.reported_value)} current reported value</small></div>
              <b>{supplier.events}</b>
            </li>
          ))}
        </ol>
      </section>
    </div>
    <a class="button button--light" href={`${base}data/`}>Explore data summaries →</a>
  </section>

  <section class="responsibility-callout">
    <span class="callout-mark" aria-hidden="true">!</span>
    <div>
      <p class="eyebrow"><span></span> Read changes responsibly</p>
      <h2>A change is a lead.<br />It is not a verdict.</h2>
    </div>
    <div>
      <p>{dashboard.disclaimer}</p>
      <a class="text-link" href={`${base}methodology/`}>Read the methodology and limitations →</a>
    </div>
  </section>
</BaseLayout>
